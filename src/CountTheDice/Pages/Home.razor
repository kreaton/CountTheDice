@page "/"
@using CountTheDice.Game
@using CountTheDice.Shared
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Tæl terningerne</PageTitle>

<main class="game">
    <header class="title">
        <h1>Tæl terningerne!</h1>
        <div class="title-right">
            <button class="sound-btn" @onclick="ToggleSound" aria-label="@(_muted ? "Slå lyden til" : "Slå lyden fra")">
                @(_muted ? "🔇" : "🔊")
            </button>
            <div class="stars" aria-label="@_stars stjerner">⭐ @_stars</div>
            <a class="kg-home" href="../" aria-label="Alle spil" title="Alle spil"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 9.5V20h4.5v-6h4v6h4.5V9.5" /></svg><span class="kg-text">Alle spil</span></a>
        </div>
    </header>

    <nav class="levels" aria-label="Vælg niveau">
        @foreach (var level in DiceGame.Levels)
        {
            <button class="level-btn level-@level.Number @(level == _game.Level ? "active" : "")"
                    @onclick="() => ChangeLevel(level)" disabled="@_rolling">
                @level.Name
                <small>@level.DiceCount terninger</small>
            </button>
        }
    </nav>

    <section class="dice-tray" @onclick="Roll" title="Tryk for at slå med terningerne">
        @for (var i = 0; i < _shownDice.Length; i++)
        {
            <Die Value="_shownDice[i]" Rolling="_rolling" Color="@DieColors[i % DieColors.Length]" />
        }
    </section>

    <div class="answers">
    <p class="question">Hvor mange øjne er der i alt?</p>

    <section class="choices">
        @foreach (var choice in _game.Choices)
        {
            var state = _solved && _game.IsCorrect(choice) ? "correct"
                : _wrongPicks.Contains(choice) ? "wrong" : "";
            <button class="choice @state" @onclick="() => Pick(choice)"
                    disabled="@(_rolling || _solved || _wrongPicks.Contains(choice))">
                @choice
            </button>
        }
    </section>

    <section class="feedback" aria-live="polite">
        @if (_solved)
        {
            <div class="message success">
                <span class="big-emoji">🎉</span>
                <span>Super! @_game.Sum er rigtigt!</span>
            </div>
            <button class="roll-btn" @onclick="Roll">🎲 Slå igen!</button>
        }
        else if (_lastWrong is not null)
        {
            <div class="message try-again" @key="_wrongPicks.Count">
                <span class="big-emoji">🤔</span>
                <span>Ikke @_lastWrong. Prøv igen!</span>
            </div>
        }
    </section>
    </div>

    <footer class="credits">Lavet med kærlighed 💛 (c) 2026 Per Hejndorf, Kreaton – @BuildInfo.Display</footer>
</main>

@code {
    private static readonly string[] DieColors = ["#ff6b6b", "#4dabf7", "#51cf66"];

    private readonly DiceGame _game = new();
    private IJSObjectReference? _sounds;
    private bool _muted;
    private readonly HashSet<int> _wrongPicks = [];
    private int[] _shownDice = [];
    private bool _rolling;
    private bool _solved;
    private int? _lastWrong;
    private int _stars;

    protected override async Task OnInitializedAsync() => await Roll();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _sounds = await JS.InvokeAsync<IJSObjectReference>("import", "./js/sounds.js");
        _muted = await _sounds.InvokeAsync<bool>("isMuted");
        StateHasChanged();
    }

    private async Task ToggleSound()
    {
        _muted = !_muted;
        if (_sounds is not null) await _sounds.InvokeVoidAsync("setMuted", _muted);
    }

    private async Task PlaySound(string name)
    {
        if (_muted || _sounds is null) return;
        await _sounds.InvokeVoidAsync(name);
    }

    public async ValueTask DisposeAsync()
    {
        if (_sounds is not null) await _sounds.DisposeAsync();
    }

    private async Task ChangeLevel(GameLevel level)
    {
        if (level == _game.Level) return;
        _game.SetLevel(level);
        await Roll();
    }

    private async Task Roll()
    {
        if (_rolling) return;

        _rolling = true;
        _solved = false;
        _lastWrong = null;
        _wrongPicks.Clear();

        // Tumble through a few random faces before landing on the real roll.
        for (var i = 0; i < 8; i++)
        {
            _shownDice = _game.RollDice();
            StateHasChanged();
            await Task.Delay(70);
        }

        _game.NewRound();
        _shownDice = _game.Dice;
        _rolling = false;
    }

    private async Task Pick(int choice)
    {
        if (_game.IsCorrect(choice))
        {
            _solved = true;
            _lastWrong = null;
            _stars++;
            await PlaySound("playSuccess");
        }
        else
        {
            _wrongPicks.Add(choice);
            _lastWrong = choice;
            await PlaySound("playTryAgain");
        }
    }
}
